# Klaus - Einstellungen. Kopiere diese Datei zu ".env" und trage deine Werte ein.
# Die .env ist in .gitignore und darf NIE ins Repo (enthaelt Schluessel).

# ------------------------------------------------------------------ Gespraech (Gemini Live)
# Schluessel: https://aistudio.google.com/apikey  - leer = alles lokal (Whisper -> Ollama -> Stimme)
GEMINI_API_KEY=
# Stimme von Gemini Live: Charon, Puck, Kore, Fenrir, Orus, Aoede ...
GEMINI_STIMME=Charon
# 1 = man kann Klaus ins Wort fallen
KLAUS_UNTERBRECHEN=1

# ------------------------------------------------------------------ Spracherkennung + lokale Stimme
# Teil des Mikrofon-Namens (z. B. "USB" oder "IC 6010"); leer = Standardmikrofon
KLAUS_MIC=
# Whisper-Modell fuers Weckwort: tiny | base | small | medium (laeuft auf der Grafikkarte, wenn vorhanden)
WHISPER_MODEL=small
# Ersatzstimme ohne Gemini: edge:<Stimme> oder ein Piper-Modell aus data/stimmen
KLAUS_STIMME=edge:de-DE-FlorianMultilingualNeural
# Lokales Sprachmodell (Ollama) als Rueckfall
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# ------------------------------------------------------------------ Claude (nur wenn du ausdruecklich "Claude" sagst)
# Rechte fuer Claude Code beim Bauen von Projekten (acceptEdits = nur Dateien, bypassPermissions = alles)
CLAUDE_PERMISSION_MODE=acceptEdits

# ------------------------------------------------------------------ Recherche
# Optional: Tavily-Websuche (Gratis-Kontingent). Leer = kostenlose Suche ueber ddgs
TAVILY_API_KEY=

# ------------------------------------------------------------------ Absender fuer Briefe (Leads)
KLESRO_ABSENDER_NAME=Dein Name
KLESRO_ABSENDER_FIRMA=Deine Firma
KLESRO_ABSENDER_MAIL=kontakt@example.de
KLESRO_ADRESSE=Musterstraße 1, 12345 Musterstadt
KLESRO_TELEFON=
KLESRO_WEBSITE=https://example.de

# Webspace per SFTP: Klaus laedt die Website-Entwuerfe der Briefe hoch (QR-Codes) - nur nach deiner Freigabe
KLESRO_SFTP_HOST=
KLESRO_SFTP_USER=
KLESRO_SFTP_PASS=
# Ordner, auf den deine Domain zeigt, z. B. / oder /meine-website
KLESRO_SFTP_ORDNER=/

# ------------------------------------------------------------------ Ort + Gedaechtnis
# Heimatort fuer Wetter, Region im Lagebericht und Lead-Suche: Name,Breitengrad,Laengengrad
KLAUS_ORT=Göppingen,48.70,9.65
# Obsidian-Vault fuer Klaus' Gedaechtnis (leer = Dokumente\Klaus Gedächtnis)
KLAUS_VAULT=
# 0 = Gespraeche nicht als Tagesnotiz mitschreiben
KLAUS_PROTOKOLL=1

# ------------------------------------------------------------------ Alt (Lead-Suche ueber bezahlte APIs, ersetzt durch OpenStreetMap)
GOOGLE_PLACES_API_KEY=
OPENWEB_NINJA_API_KEY=
