# Klaus - Einstellungen. Kopiere diese Datei zu ".env" und trage deine Werte ein.
# Die .env ist in .gitignore und darf NIE ins Repo (enthaelt Schluessel).

# ------------------------------------------------------------------ Gespraech (Gemini Live)
# Schluessel: https://aistudio.google.com/apikey  - leer = alles lokal (Whisper -> Ollama -> Stimme)
GEMINI_API_KEY=
# Stimme von Gemini Live: Charon, Puck, Kore, Fenrir, Orus, Aoede ...
GEMINI_STIMME=Charon
# 1 = man kann Klaus ins Wort fallen
KLAUS_UNTERBRECHEN=1

# ------------------------------------------------------------------ Spracherkennung + lokale Stimme
# Teil des Mikrofon-Namens (z. B. "USB" oder "IC 6010"); leer = Standardmikrofon
KLAUS_MIC=
# Whisper-Modell fuers Weckwort: tiny | base | small | medium (laeuft auf der Grafikkarte, wenn vorhanden)
WHISPER_MODEL=small
# Ersatzstimme ohne Gemini: edge:<Stimme> oder ein Piper-Modell aus data/stimmen
KLAUS_STIMME=edge:de-DE-FlorianMultilingualNeural
# Lokales Sprachmodell (Ollama) als Rueckfall
OLLAMA_MODEL=qwen2.5:7b-instruct-q4_K_M

# ------------------------------------------------------------------ Claude (nur wenn du ausdruecklich "Claude" sagst)
# Rechte fuer Claude Code beim Bauen von Projekten (acceptEdits = nur Dateien, bypassPermissions = alles)
CLAUDE_PERMISSION_MODE=acceptEdits

# ------------------------------------------------------------------ Recherche
# Optional: Tavily-Websuche (Gratis-Kontingent). Leer = kostenlose Suche ueber ddgs
TAVILY_API_KEY=

# ------------------------------------------------------------------ Absender fuer Briefe (Leads)
KLESRO_ABSENDER_NAME=Dein Name
KLESRO_ABSENDER_FIRMA=Deine Firma
KLESRO_ABSENDER_MAIL=kontakt@example.de
KLESRO_ADRESSE=Musterstraße 1, 12345 Musterstadt
KLESRO_TELEFON=
KLESRO_WEBSITE=https://example.de

# Webspace per SFTP: Klaus laedt die Website-Entwuerfe der Briefe hoch (QR-Codes) - nur nach deiner Freigabe
KLESRO_SFTP_HOST=
KLESRO_SFTP_USER=
KLESRO_SFTP_PASS=
# Ordner, auf den deine Domain zeigt, z. B. / oder /meine-website
KLESRO_SFTP_ORDNER=/

# ------------------------------------------------------------------ Natuerliche Stimme (Fish Audio, bezahlt)
# Schluessel: fish.audio -> API. Eigene Stimme entwerfen: .venv\Scripts\python.exe src\fish.py entwerfen "Beschreibung"
FISH_API_KEY=
# Stimm-Modell (reference_id) - setzt "fish.py anlegen <nr>" automatisch
FISH_STIMME=
FISH_MODELL=s2.1-pro
# fish = Gemini denkt, Fish spricht (wenn Schluessel + Stimme da) | gemini = Geminis eigene Stimme
KLAUS_STIMME_ANBIETER=fish

# ------------------------------------------------------------------ Apple Kalender (iCloud, CalDAV)
# appleid.apple.com -> Anmeldung und Sicherheit -> App-spezifische Passwoerter (NICHT dein normales Passwort)
APPLE_ID=
APPLE_APP_PASSWORT=
# Optional: nur diese Kalender lesen (Komma), Ziel-Kalender fuer neue Termine
KLAUS_KALENDER=
KLAUS_KALENDER_NEU=

# ------------------------------------------------------------------ Ort + Gedaechtnis
# Heimatort fuer Wetter, Region im Lagebericht und Lead-Suche: Name,Breitengrad,Laengengrad
KLAUS_ORT=Göppingen,48.70,9.65
# Obsidian-Vault fuer Klaus' Gedaechtnis (leer = Dokumente\Klaus Gedächtnis)
KLAUS_VAULT=
# 0 = Gespraeche nicht als Tagesnotiz mitschreiben
KLAUS_PROTOKOLL=1

# ------------------------------------------------------------------ Alt (Lead-Suche ueber bezahlte APIs, ersetzt durch OpenStreetMap)
GOOGLE_PLACES_API_KEY=
OPENWEB_NINJA_API_KEY=

# --- Telegram: mit Klaus chatten, wenn du nicht am PC bist (telegram_bot.py) ---
# Bot bei @BotFather anlegen (/newbot) und den Token hier eintragen. Dann einen Einmal-Code in TELEGRAM_KOPPELCODE
# schreiben und dem Bot "/start <code>" schicken - Klaus speichert dein Konto (TELEGRAM_NUTZER) und fragt nach einer
# PIN fuer Freigaben (als Hash in TELEGRAM_PIN). Nur dieses eine Konto bekommt Antworten.
TELEGRAM_TOKEN=
TELEGRAM_NUTZER=
TELEGRAM_KOPPELCODE=
TELEGRAM_PIN=

# --- Ersatz-KI, wenn Gemini ausfaellt (ersatz_ki.py): kostenloser Schluessel unter console.groq.com -> API Keys ---
# Jeder Anbieter mit "OpenAI-kompatibler" Schnittstelle geht (ERSATZ_KI_URL, z. B. https://openrouter.ai/api/v1).
GROQ_API_KEY=
# ERSATZ_KI_MODELLE=openai/gpt-oss-120b,openai/gpt-oss-20b
# Optional: News-Quelle fuer die Markt-Analyse (newsapi.org, Free-Tarif nur fuer Entwicklung)
# NEWSAPI_KEY=

# --- Alpaca: echtes Broker-Konto (US-Aktien, ETFs, Krypto) - NUR in der .env des SERVERS (alpaca_handel.py) ---
# Schluessel: app.alpaca.markets -> Paper Trading -> API Keys. Jede Order braucht deine Freigabe (Telegram-Knopf + PIN).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# 1 = ECHTGELD (dann Live-Schluessel oben eintragen). Leer/0 = Papier-Konto von Alpaca (Spielgeld).
ALPACA_LIVE=0
# Optional: Hoechstbetrag je Kauf-Order in US-Dollar. Leer = keine Grenze (die Kaufkraft des Kontos begrenzt trotzdem)
ALPACA_MAX_ORDER_USD=
# Eigene Strategien (strategien.py, nur Papier-Konto) - alle optional, leer = keine Grenze:
# Budgets aller aktiven Strategien zusammen (USD), Anzahl aktiver Strategien, Orders je Strategie und Tag
STRATEGIE_GESAMT_USD=
STRATEGIE_MAX_AKTIV=
STRATEGIE_MAX_ORDERS_TAG=

# --- PC: automatisches Update aus GitHub (pc_update.py), alle 30 Minuten in ruhigen Momenten. 0 = aus ---
KLAUS_AUTO_UPDATE=1
