leb# Kopiere diese Datei zu ".env" und trage deinen echten Key ein.

# Google Places API (Google Cloud Console -> Places API aktivieren)
GOOGLE_PLACES_API_KEY=

# Alternative statt Google Places: OpenWeb Ninja (openwebninja.com)
# Wenn gesetzt, nutzt search_leads.py automatisch diesen Anbieter.
OPENWEB_NINJA_API_KEY=

# Absenderdaten für die generierten E-Mail-Entwürfe
KLESRO_ABSENDER_NAME=Nikola Georgiev
KLESRO_ABSENDER_FIRMA=Klesro Web
KLESRO_ABSENDER_MAIL=info@klesro-web.de

# Rechte fuer Claude Code beim Bauen (acceptEdits = nur Dateien, bypassPermissions = alles)
CLAUDE_PERMISSION_MODE=bypassPermissions

# Gehirn: auto = schwierige Fragen an Claude, Kurzes lokal | claude = alles an Claude | lokal = nur Ollama
KLAUS_GEHIRN=auto
# Claude-Modell fuer das Gehirn (opus, sonnet, ...)
KLAUS_CLAUDE_MODELL=opus

# Gemini Live fuer das Gespraech (Schluessel: https://aistudio.google.com/apikey). Leer = alles lokal.
GEMINI_API_KEY=
# Stimme: Charon, Puck, Kore, Fenrir, Orus, Aoede ...
GEMINI_STIMME=Charon
# 1 = man kann Klaus ins Wort fallen
KLAUS_UNTERBRECHEN=1

# Fuer die Briefe (Absender, Kontakt, QR-Code)
KLESRO_ADRESSE=
KLESRO_TELEFON=
KLESRO_WEBSITE=https://klesro-web.de

# IONOS-Webspace (Hosting -> SFTP & SSH): Klaus laedt dort die Website-Entwuerfe fuer die QR-Codes hoch
KLESRO_SFTP_HOST=
KLESRO_SFTP_USER=
KLESRO_SFTP_PASS=
# Ordner, auf den klesro-web.de zeigt (IONOS: Domains -> Ziel), z. B. / oder /klesro-web
KLESRO_SFTP_ORDNER=/

# Optional: Tavily statt der kostenlosen Suche (ddgs). Leer lassen = kostenlos
TAVILY_API_KEY=
